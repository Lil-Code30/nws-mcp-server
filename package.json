{
  "name": "unofficial-nmw-mcp-server",
  "version": "1.0.2-0",
  "description": "unofficial MCP Server base on the National Weather Service API",
  "main": "./build/index.js",
  "bin": {
    "nmw-mcp-weather-server": "./build/index.js"
  },
  "scripts": {
    "test": "tsc && chmod 755 build/index.js",
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js",
    "release": "release-it"
  },
  "files": [
    "build"
  ],
